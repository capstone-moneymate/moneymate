# 이 파일을 .env로 복사한 뒤 값을 채웁니다. .env는 커밋하지 않습니다.
# 키 이름만 적습니다. 실제 값은 팀 채널로 따로 공유합니다.

# DB (docker-compose 설정에 맞춰 A가 확정)
DATABASE_URL=

# Claude API (Anthropic Console에서 월 사용 한도 먼저 설정)
ANTHROPIC_API_KEY=

# 네이버 검색 API (뉴스)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 13F: edgartools set_identity용 (이름 이메일)
EDGAR_IDENTITY=

# OpenFIGI API v3 (CUSIP → 티커)
OPENFIGI_API_KEY=
