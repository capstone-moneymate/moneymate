# 이 파일을 복사해 .env 로 만들고 값을 채운다.  cp .env.example .env
# .env 는 절대 git에 올리지 않는다. (.gitignore 에 들어 있음)

# --- PostgreSQL (docker-compose.yml 이 읽음) ---
POSTGRES_USER=moneymate
POSTGRES_PASSWORD=moneymate
POSTGRES_DB=moneymate
POSTGRES_PORT=5432
# 워커(Python)와 서버(Node)가 쓰는 접속 문자열
DATABASE_URL=postgresql://moneymate:moneymate@localhost:5432/moneymate

# --- 13F (A) ---
# SEC가 요구하는 신원 표시. "이름 이메일" 형식, 본인 것으로 채운다.
# 이름은 영문만 (한글이면 요청 오류), naver.com 메일은 SEC가 403 으로 거부한다 (gmail·학교 메일 OK).
EDGAR_IDENTITY=
# OpenFIGI (CUSIP -> 티커). 키 없이도 되지만 한도가 낮다. 있으면 넣는다.
OPENFIGI_API_KEY=

# --- 뉴스 (C) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Claude (C가 월 한도 설정 후 사용, A는 채점용) ---
ANTHROPIC_API_KEY=
# 월 비용 상한(USD). llm_client.py 가 넘으면 호출을 막는다.
LLM_MONTHLY_LIMIT_USD=10

# --- 공통 ---
TZ=Asia/Seoul
